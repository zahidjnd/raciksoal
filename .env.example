# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh masuk Git.

# Database lokal (Docker). Di hosting diganti dengan database cPanel.
DATABASE_URL=postgres://raciksoal:raciksoal@localhost:5432/raciksoal

# Login (Better Auth)
# Kunci rahasia acak, buat sendiri dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=isi-dengan-hasil-perintah-di-atas
# Alamat web: laptop = http://localhost:3000, hosting = https://raciksoal.alfatahmas.com
BETTER_AUTH_URL=http://localhost:3000
# Nama pengguna yang boleh menjadi admin pertama (huruf kecil, angka, titik, garis bawah)
ADMIN_USERNAME=nama.admin

# Batas waktu satu panggilan AI (berlaku untuk semua model)
AI_TIMEOUT_MS=180000

# Model 1 (format OpenAI). Contoh DeepSeek:
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=isi-kunci-api-di-sini
AI_MODEL=deepseek-flash
# Opsional: matikan mode "berpikir" DeepSeek supaya cepat & tidak menghabiskan batas token
AI_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# Model 2, 3, ... untuk perbandingan (awalan AI2_, AI3_, dst.). Contoh Gemini:
AI2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI2_API_KEY=isi-kunci-gemini-di-sini
AI2_MODEL=gemini-3.8-flash
# Opsional per model: AI2_MAX_TOKENS=8000, AI2_EXTRA_BODY='{...}'
