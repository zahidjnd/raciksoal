# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh masuk Git.

# Database lokal (Docker). Di hosting diganti dengan database cPanel.
DATABASE_URL=postgres://raciksoal:raciksoal@localhost:5432/raciksoal

# AI (format OpenAI). Contoh DeepSeek:
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=isi-kunci-api-di-sini
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=90000
